<!DOCTYPE html>
<html>
<head>
  <title>Quản lý sản phẩm</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="bg-light">
<div class="container py-4">

  <h1 class="mb-3">Quản lý sản phẩm</h1>

  <a href="/products/admin/add" class="btn btn-primary mb-3">➕ Thêm sản phẩm</a>

  <table class="table table-bordered">
    <thead class="table-dark">
      <tr>
        <th>Ảnh</th>
        <th>Tên</th>
        <th>Giá</th>
        <th>Mô tả</th>
        <th>Thao tác</th>
      </tr>
    </thead>

    <tbody>
      <% products.forEach(p => { %>
        <tr>
          <!-- ẢNH -->
          <td>
            <img src="<%= p.image %>" width="80" style="border-radius:6px;">
          </td>

          <!-- TÊN -->
          <td><%= p.name %></td>

          <!-- GIÁ -->
          <td><%= p.price.toLocaleString() %> VNĐ</td>

          <!-- MÔ TẢ -->
          <td><%= p.description %></td>

          <!-- NÚT SỬA / XÓA -->
          <td>
            <a href="/products/admin/edit/<%= p.id %>"
               class="btn btn-warning btn-sm">Sửa</a>

            <a href="/products/admin/delete/<%= p.id %>"
               class="btn btn-danger btn-sm">Xóa</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>
</body>
</html>
