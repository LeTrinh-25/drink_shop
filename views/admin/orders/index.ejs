<%- include('../partials/header', { pageTitle: 'Quản lý đơn hàng' }) %>

<!-- Thẻ nhanh theo trạng thái, bấm vào để lọc -->
<div class="row g-2 mb-3">
  <%
    var quick = [
      { key: '',          label: 'Tất cả',       color: 'secondary', icon: 'bi-list-ul' },
      { key: 'pending',   label: 'Chờ xác nhận', color: 'warning',   icon: 'bi-hourglass-split' },
      { key: 'confirmed', label: 'Đã xác nhận',  color: 'info',      icon: 'bi-check2-circle' },
      { key: 'shipping',  label: 'Đang giao',    color: 'primary',   icon: 'bi-truck' },
      { key: 'completed', label: 'Hoàn thành',   color: 'success',   icon: 'bi-bag-check' },
      { key: 'cancelled', label: 'Đã hủy',       color: 'danger',    icon: 'bi-x-circle' }
    ];
    var grandTotal = Object.keys(statusCounts).reduce(function (s, k) { return s + statusCounts[k]; }, 0);
  %>
  <% quick.forEach(function (s) { %>
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/admin/orders<%= s.key ? '?status=' + s.key : '' %>"
         class="admin-card d-block text-decoration-none p-3 h-100
                <%= (query.status || '') === s.key ? 'border-primary border-2' : '' %>">
        <div class="d-flex align-items-center gap-2 text-<%= s.color %>">
          <i class="bi <%= s.icon %>"></i>
          <span class="small fw-semibold"><%= s.label %></span>
        </div>
        <div class="h4 fw-bold mb-0 mt-1 text-dark">
          <%= s.key ? (statusCounts[s.key] || 0) : grandTotal %>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<div class="admin-card">
  <div class="admin-card__header">
    <h2 class="admin-card__title">
      Đơn hàng <span class="badge bg-light text-secondary ms-1"><%= result.total %></span>
    </h2>
  </div>

  <!-- ===== Tìm kiếm & lọc ===== -->
  <div class="admin-card__body border-bottom">
    <form class="filter-bar" method="GET" action="/admin/orders" data-no-loading>
      <div class="flex-grow-1" style="min-width:190px;">
        <label class="form-label small text-muted mb-1">Tìm kiếm</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="q" value="<%= query.q || '' %>"
                 placeholder="Mã đơn, tên khách hoặc SĐT...">
        </div>
      </div>

      <div>
        <label class="form-label small text-muted mb-1">Trạng thái</label>
        <select class="form-select form-select-sm" name="status" data-auto-submit>
          <option value="">Tất cả</option>
          <% Object.keys(statusLabels).forEach(function (key) { %>
            <option value="<%= key %>" <%= query.status === key ? 'selected' : '' %>>
              <%= statusLabels[key] %>
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="form-label small text-muted mb-1">Từ ngày</label>
        <input type="date" class="form-control form-control-sm" name="from" value="<%= query.from || '' %>">
      </div>

      <div>
        <label class="form-label small text-muted mb-1">Đến ngày</label>
        <input type="date" class="form-control form-control-sm" name="to" value="<%= query.to || '' %>">
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-funnel me-1"></i>Lọc</button>
        <a href="/admin/orders" class="btn btn-light btn-sm">Xóa lọc</a>
      </div>
    </form>
  </div>

  <!-- ===== Danh sách ===== -->
  <% if (result.items.length === 0) { %>
    <div class="admin-state">
      <i class="bi bi-receipt"></i>
      <div class="admin-state__title">Không có đơn hàng nào</div>
      <p class="small mb-0">
        <%= query.q || query.status || query.from || query.to
              ? 'Thử thay đổi bộ lọc để xem thêm kết quả.'
              : 'Đơn hàng khách đặt trên trang bán hàng sẽ hiển thị tại đây.' %>
      </p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th class="d-none d-lg-table-cell">Địa chỉ</th>
            <th class="d-none d-sm-table-cell">Thanh toán</th>
            <th class="text-end">Tổng tiền</th>
            <th>Trạng thái</th>
            <th class="d-none d-md-table-cell">Ngày đặt</th>
            <th class="text-end">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% result.items.forEach(function (o) { %>
            <tr>
              <td>
                <a class="fw-semibold text-decoration-none" href="/admin/orders/<%= o.id %>/detail">#<%= o.id %></a>
              </td>
              <td>
                <div class="fw-semibold"><%= o.customerName %></div>
                <div class="text-muted small"><%= o.phone %></div>
              </td>
              <td class="d-none d-lg-table-cell text-muted small text-truncate" style="max-width:220px;">
                <%= o.address %>
              </td>
              <td class="d-none d-sm-table-cell small">
                <%= o.paymentMethod === 'bank' ? '🏦 Chuyển khoản' : '💵 Tiền mặt' %>
              </td>
              <td class="text-end fw-semibold text-danger"><%= formatMoney(o.total) %>đ</td>
              <td>
                <!-- Đổi trạng thái nhanh ngay trên bảng -->
                <form method="POST" action="/admin/orders/<%= o.id %>/status" data-no-loading>
                  <select name="status" class="form-select form-select-sm border-<%= statusColors[o.status] %>"
                          style="min-width:135px;" data-auto-submit>
                    <% Object.keys(statusLabels).forEach(function (key) { %>
                      <option value="<%= key %>" <%= o.status === key ? 'selected' : '' %>>
                        <%= statusLabels[key] %>
                      </option>
                    <% }) %>
                  </select>
                </form>
              </td>
              <td class="d-none d-md-table-cell text-muted small"><%= formatDate(o.createdAt) %></td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <a href="/admin/orders/<%= o.id %>/detail" class="btn btn-outline-secondary" title="Xem chi tiết">
                    <i class="bi bi-eye"></i>
                  </a>
                  <form method="POST" action="/admin/orders/<%= o.id %>/delete" class="d-inline"
                        data-confirm="Xóa đơn hàng #<%= o.id %>? Toàn bộ chi tiết đơn sẽ bị xóa theo.">
                    <button class="btn btn-outline-danger" type="submit" title="Xóa">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</div>

<%- include('../partials/footer') %>
