<%- include('partials/header', { pageTitle: 'Cài đặt tài khoản' }) %>

<div class="row g-3">

  <!-- Thông tin cá nhân -->
  <div class="col-12 col-lg-6">
    <div class="admin-card h-100">
      <div class="admin-card__header">
        <h2 class="admin-card__title"><i class="bi bi-person-gear me-1"></i>Thông tin tài khoản</h2>
      </div>

      <form method="POST" action="/admin/settings/profile" novalidate>
        <div class="admin-card__body">
          <div class="mb-3">
            <label class="form-label fw-semibold small">Tên đăng nhập</label>
            <input type="text" class="form-control" value="<%= user.username %>" disabled>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small" for="fullName">Họ và tên</label>
            <input type="text" class="form-control" id="fullName" name="fullName"
                   value="<%= user.fullName || '' %>" placeholder="Nguyễn Văn A">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small" for="email">Email</label>
            <input type="email" class="form-control" id="email" name="email"
                   value="<%= user.email || '' %>" placeholder="admin@drinkshop.vn">
          </div>

          <div class="mb-0">
            <label class="form-label fw-semibold small" for="phone">Số điện thoại</label>
            <input type="text" class="form-control" id="phone" name="phone"
                   value="<%= user.phone || '' %>" placeholder="0123456789">
          </div>
        </div>

        <div class="admin-card__body border-top">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Lưu thông tin
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Đổi mật khẩu -->
  <div class="col-12 col-lg-6">
    <div class="admin-card h-100">
      <div class="admin-card__header">
        <h2 class="admin-card__title"><i class="bi bi-shield-lock me-1"></i>Đổi mật khẩu</h2>
      </div>

      <form method="POST" action="/admin/settings/password" novalidate>
        <div class="admin-card__body">
          <div class="mb-3">
            <label class="form-label fw-semibold small" for="currentPassword">
              Mật khẩu hiện tại <span class="text-danger">*</span>
            </label>
            <input type="password" class="form-control" id="currentPassword"
                   name="currentPassword" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small" for="newPassword">
              Mật khẩu mới <span class="text-danger">*</span>
            </label>
            <input type="password" class="form-control" id="newPassword"
                   name="newPassword" minlength="6" required>
            <div class="form-text">Tối thiểu 6 ký tự.</div>
          </div>

          <div class="mb-0">
            <label class="form-label fw-semibold small" for="confirmPassword">
              Xác nhận mật khẩu mới <span class="text-danger">*</span>
            </label>
            <input type="password" class="form-control" id="confirmPassword"
                   name="confirmPassword" minlength="6" required>
          </div>
        </div>

        <div class="admin-card__body border-top">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-key me-1"></i>Đổi mật khẩu
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Thông tin hệ thống -->
  <div class="col-12">
    <div class="admin-card">
      <div class="admin-card__header">
        <h2 class="admin-card__title"><i class="bi bi-info-circle me-1"></i>Thông tin hệ thống</h2>
      </div>
      <div class="admin-card__body">
        <div class="row g-3 small">
          <div class="col-6 col-md-3">
            <div class="text-muted">Nền tảng</div>
            <div class="fw-semibold">NestJS + TypeORM</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="text-muted">Cơ sở dữ liệu</div>
            <div class="fw-semibold">MySQL</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="text-muted">Số quản trị viên</div>
            <div class="fw-semibold"><%= adminCount %></div>
          </div>
          <div class="col-6 col-md-3">
            <div class="text-muted">Quản lý tài khoản Admin</div>
            <a href="/admin/users?role=admin" class="fw-semibold text-decoration-none">
              Xem danh sách <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
