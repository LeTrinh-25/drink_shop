<%- include('../partials/header', { pageTitle: 'Chi tiết người dùng' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb small">
    <li class="breadcrumb-item"><a href="/admin/users" class="text-decoration-none">Người dùng</a></li>
    <li class="breadcrumb-item active"><%= user.username %></li>
  </ol>
</nav>

<div class="row g-3">
  <!-- Thông tin tài khoản -->
  <div class="col-12 col-lg-4">
    <div class="admin-card">
      <div class="admin-card__body text-center">
        <span class="avatar-circle mb-3" style="width:76px;height:76px;font-size:30px;">
          <%= (user.fullName || user.username).charAt(0) %>
        </span>
        <h2 class="h5 fw-bold mb-1"><%= user.fullName || user.username %></h2>
        <p class="text-muted mb-2">@<%= user.username %></p>

        <div class="d-flex gap-2 justify-content-center mb-3">
          <span class="badge bg-<%= user.role === 'admin' ? 'primary' : 'secondary' %>">
            <%= user.role === 'admin' ? 'Admin' : 'User' %>
          </span>
          <span class="badge bg-<%= user.isActive ? 'success' : 'danger' %>">
            <%= user.isActive ? 'Hoạt động' : 'Đã khóa' %>
          </span>
        </div>

        <a href="/admin/users/<%= user.id %>/edit" class="btn btn-primary btn-sm w-100">
          <i class="bi bi-pencil me-1"></i>Chỉnh sửa
        </a>
      </div>

      <div class="admin-card__body border-top small">
        <div class="d-flex justify-content-between py-1">
          <span class="text-muted">ID</span><span class="fw-semibold">#<%= user.id %></span>
        </div>
        <div class="d-flex justify-content-between py-1">
          <span class="text-muted">Email</span><span class="fw-semibold text-truncate ms-2"><%= user.email || '—' %></span>
        </div>
        <div class="d-flex justify-content-between py-1">
          <span class="text-muted">Điện thoại</span><span class="fw-semibold"><%= user.phone || '—' %></span>
        </div>
        <div class="d-flex justify-content-between py-1">
          <span class="text-muted">Ngày tạo</span><span class="fw-semibold"><%= formatDate(user.createdAt) %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Lịch sử mua hàng -->
  <div class="col-12 col-lg-8">
    <div class="row g-3 mb-3">
      <div class="col-6">
        <div class="stat-card">
          <div class="stat-card__icon bg-soft-warning"><i class="bi bi-receipt"></i></div>
          <div>
            <p class="stat-card__label">Tổng đơn</p>
            <p class="stat-card__value"><%= orders.length %></p>
          </div>
        </div>
      </div>
      <div class="col-6">
        <div class="stat-card">
          <div class="stat-card__icon bg-soft-success"><i class="bi bi-cash-coin"></i></div>
          <div>
            <p class="stat-card__label">Đã chi tiêu</p>
            <p class="stat-card__value"><%= formatMoney(totalSpent) %>đ</p>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card__header">
        <h2 class="admin-card__title">Lịch sử đơn hàng</h2>
      </div>

      <% if (orders.length === 0) { %>
        <div class="admin-state">
          <i class="bi bi-bag"></i>
          <div class="admin-state__title">Người dùng chưa có đơn hàng nào</div>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Mã đơn</th>
                <th class="d-none d-md-table-cell">Số món</th>
                <th class="text-end">Tổng tiền</th>
                <th>Trạng thái</th>
                <th class="d-none d-sm-table-cell">Ngày đặt</th>
              </tr>
            </thead>
            <tbody>
              <%
                var colors = { pending:'warning', confirmed:'info', shipping:'primary', completed:'success', cancelled:'danger' };
                var labels = { pending:'Chờ xác nhận', confirmed:'Đã xác nhận', shipping:'Đang giao', completed:'Hoàn thành', cancelled:'Đã hủy' };
              %>
              <% orders.forEach(function (o) { %>
                <tr>
                  <td><a class="fw-semibold text-decoration-none" href="/admin/orders/<%= o.id %>/detail">#<%= o.id %></a></td>
                  <td class="d-none d-md-table-cell"><%= o.items ? o.items.length : 0 %></td>
                  <td class="text-end fw-semibold text-danger"><%= formatMoney(o.total) %>đ</td>
                  <td><span class="badge bg-<%= colors[o.status] %>"><%= labels[o.status] %></span></td>
                  <td class="d-none d-sm-table-cell text-muted small"><%= formatDate(o.createdAt) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
