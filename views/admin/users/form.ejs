<%- include('../partials/header', { pageTitle: isEdit ? 'Sửa người dùng' : 'Thêm người dùng' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb small">
    <li class="breadcrumb-item"><a href="/admin/users" class="text-decoration-none">Người dùng</a></li>
    <li class="breadcrumb-item active"><%= isEdit ? 'Chỉnh sửa' : 'Thêm mới' %></li>
  </ol>
</nav>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="admin-card">
      <div class="admin-card__header">
        <h2 class="admin-card__title">
          <i class="bi bi-person-<%= isEdit ? 'gear' : 'plus' %> me-1"></i>
          <%= isEdit ? 'Chỉnh sửa người dùng' : 'Thêm người dùng mới' %>
        </h2>
      </div>

      <form method="POST"
            action="<%= isEdit ? '/admin/users/' + user.id + '/edit' : '/admin/users/create' %>"
            novalidate>
        <div class="admin-card__body">
          <div class="row g-3">

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small" for="username">
                Tên đăng nhập <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" id="username" name="username"
                     value="<%= user.username || '' %>"
                     <%= isEdit ? 'disabled' : 'required minlength="3"' %>>
              <% if (isEdit) { %>
                <div class="form-text">Tên đăng nhập không thể thay đổi sau khi tạo.</div>
              <% } %>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small" for="password">
                Mật khẩu <%= isEdit ? '' : '<span class="text-danger">*</span>' %>
              </label>
              <input type="password" class="form-control" id="password" name="password"
                     placeholder="<%= isEdit ? 'Để trống nếu không đổi' : 'Tối thiểu 6 ký tự' %>"
                     <%= isEdit ? '' : 'required minlength="6"' %>>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small" for="fullName">Họ và tên</label>
              <input type="text" class="form-control" id="fullName" name="fullName"
                     value="<%= user.fullName || '' %>" placeholder="Nguyễn Văn A">
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small" for="email">Email</label>
              <input type="email" class="form-control" id="email" name="email"
                     value="<%= user.email || '' %>" placeholder="email@example.com">
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small" for="phone">Số điện thoại</label>
              <input type="text" class="form-control" id="phone" name="phone"
                     value="<%= user.phone || '' %>" placeholder="0123456789">
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small" for="role">Vai trò</label>
              <select class="form-select" id="role" name="role">
                <option value="user"  <%= user.role !== 'admin' ? 'selected' : '' %>>User — khách hàng</option>
                <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin — quản trị viên</option>
              </select>
              <div class="form-text">Chỉ tài khoản Admin mới truy cập được <code>/admin</code>.</div>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="isActive" name="isActive" <%= user.isActive ? 'checked' : '' %>>
                <label class="form-check-label" for="isActive">
                  Tài khoản đang hoạt động
                  <span class="text-muted small d-block">Tắt để khóa, người dùng sẽ không đăng nhập được.</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="admin-card__body border-top d-flex gap-2 flex-wrap">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i><%= isEdit ? 'Lưu thay đổi' : 'Thêm người dùng' %>
          </button>
          <a href="/admin/users" class="btn btn-light">Hủy</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
