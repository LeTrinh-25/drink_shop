<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng ký - Drink Shop</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

  <style>
    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #ff9a00, #ff5e00);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
    }

    .register-box {
      background: white;
      border-radius: 20px;
      padding: 30px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .register-box h3 {
      text-align: center;
      margin-bottom: 25px;
      font-weight: bold;
    }

    .btn-main {
      background: orange;
      border: none;
      color: white;
      font-weight: bold;
      border-radius: 30px;
      padding: 10px;
    }

    .btn-main:hover {
      background: darkorange;
    }
  </style>
</head>

<body>

<div class="register-box">
  <h3>🍹 Tạo tài khoản Drink Shop</h3>

  <% if (typeof error !== 'undefined') { %>
    <div class="alert alert-danger text-center"><%= error %></div>
  <% } %>

  <form action="/auth/register" method="POST">

    <div class="mb-3">
      <label class="fw-bold">Tài khoản</label>
      <input name="username" class="form-control" placeholder="Nhập tài khoản" required>
    </div>

    <div class="mb-3">
      <label class="fw-bold">Mật khẩu</label>
      <input name="password" type="password" class="form-control" placeholder="Nhập mật khẩu" required>
    </div>

    <button class="btn btn-main w-100 mt-3">
      Đăng ký
    </button>

  </form>

  <p class="text-center mt-3">
    Đã có tài khoản?
    <a href="/auth/login" class="fw-bold text-decoration-none text-warning">
      Đăng nhập ngay
    </a>
  </p>
</div>

</body>
</html>
